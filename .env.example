# Sweeparr Environment Configuration
# Copy this file to .env and adjust values for your setup

# ===========================================
# General Settings
# ===========================================

# Timezone
TZ=America/Chicago

# User/Group IDs (for file permissions)
PUID=1000
PGID=1000

# Sweeparr port
SWEEPARR_PORT=8484

# ===========================================
# Paths Configuration
# ===========================================

# Path for Sweeparr configuration and database
CONFIG_PATH=./config

# ===========================================
# Media Paths
# ===========================================
# These paths must be accessible by Sweeparr's container.
# Mount them as READ-ONLY for safety unless you want Sweeparr to delete files directly.
#
# IMPORTANT: After setup, configure path mappings in the Sweeparr UI:
#   - Arr Apps: Map how Radarr/Sonarr paths translate to these paths
#   - Media Servers: Map how these paths translate to media server paths

# Movies library path (as mounted in Sweeparr container)
MEDIA_MOVIES_PATH=/mnt/media/movies

# TV Shows library path (as mounted in Sweeparr container)
MEDIA_TV_PATH=/mnt/media/tv

# ===========================================
# Leaving Soon Library
# ===========================================
# This folder will contain symlinks to media files scheduled for deletion.
# It should be:
#   1. Writable by Sweeparr (to create/remove symlinks)
#   2. Accessible by your media server (to add as a library)
#
# For TrueNAS: Create a dataset for this and share it to both containers

LEAVING_SOON_PATH=/mnt/media/leaving-soon

# ===========================================
# Path Mapping Examples
# ===========================================
# After setting up Sweeparr, configure path mappings in the UI.
# Here's a typical TrueNAS Scale setup:
#
# TrueNAS Datasets:
#   /mnt/tank/media/movies
#   /mnt/tank/media/tv
#   /mnt/tank/media/leaving-soon
#
# Container Mounts:
#   Radarr:    /movies         -> /mnt/tank/media/movies
#   Sonarr:    /tv             -> /mnt/tank/media/tv
#   Jellyfin:  /media/movies   -> /mnt/tank/media/movies
#              /media/tv       -> /mnt/tank/media/tv
#              /leaving-soon   -> /mnt/tank/media/leaving-soon
#   Sweeparr:  /data/media/movies -> /mnt/tank/media/movies
#              /data/media/tv     -> /mnt/tank/media/tv
#              /data/leaving-soon -> /mnt/tank/media/leaving-soon
#
# Sweeparr Path Mapping Configuration:
#
# Radarr (Arr App):
#   arrPath: /movies -> localPath: /data/media/movies
#
# Sonarr (Arr App):
#   arrPath: /tv -> localPath: /data/media/tv
#
# Jellyfin (Media Server):
#   Path Mappings:
#     localPath: /data/media/movies -> mediaServerPath: /media/movies
#     localPath: /data/media/tv -> mediaServerPath: /media/tv
#   Leaving Soon Paths:
#     moviesLocalPath: /data/leaving-soon/movies
#     tvLocalPath: /data/leaving-soon/tv
#     moviesMediaPath: /leaving-soon/movies
#     tvMediaPath: /leaving-soon/tv

# ===========================================
# TrueNAS API (Optional)
# ===========================================
# If using TrueNAS, Sweeparr can monitor storage directly via API

# TRUENAS_HOST=truenas.local
# TRUENAS_API_KEY=your-api-key-here
# TRUENAS_USE_SSL=true
