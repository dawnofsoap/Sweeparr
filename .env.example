# Sweeparr Environment Configuration
# Copy this file to .env and adjust values for your setup.
# See README.md for detailed documentation.

# =============================================================================
# GENERAL SETTINGS
# =============================================================================

# Sweeparr image version
# Options: development-alpha, latest (when available)
SWEEPARR_VERSION=development-alpha

# Web UI port
SWEEPARR_PORT=8484

# Timezone for scheduled tasks and logs
TZ=America/Chicago

# User/Group IDs for file permissions
# Match these to your media stack for consistent permissions
# TrueNAS Scale typically uses 568 for the apps user
PUID=1000
PGID=1000

# =============================================================================
# PATHS - REQUIRED
# =============================================================================

# Sweeparr configuration and database storage
CONFIG_PATH=./config

# =============================================================================
# PATHS - OPTIONAL
# =============================================================================

# Application logs
LOG_PATH=./logs

# Leaving Soon symlink destination
# Required if using the "Leaving Soon" feature
# Must be accessible by both Sweeparr (read-write) and your media server (read)
LEAVING_SOON_PATH=./leaving-soon

# Media library paths (as mounted in Sweeparr container)
# Only needed if Sweeparr requires direct file access
# Recommended to mount as read-only (:ro) for safety
# MEDIA_MOVIES_PATH=/mnt/media/movies
# MEDIA_TV_PATH=/mnt/media/tv

# =============================================================================
# PATH MAPPING REFERENCE
# =============================================================================
# After deploying Sweeparr, configure path mappings in the UI:
# Settings → Connections → [Edit Arr App or Media Server]
#
# Path mappings translate file paths between different containers.
# Example setup where all containers access the same physical storage:
#
#   Physical Storage     Container Mount Points
#   ─────────────────────────────────────────────────────
#   /mnt/tank/movies  →  Radarr:    /movies
#                        Sweeparr:  /data/media/movies
#                        Jellyfin:  /media/movies
#
# Sweeparr Path Mapping Configuration:
#
#   Radarr (Arr App):
#     Arr Path: /movies  →  Local Path: /data/media/movies
#
#   Jellyfin (Media Server):
#     Local Path: /data/media/movies  →  Media Server Path: /media/movies
#
#   Leaving Soon:
#     Movies Local Path: /data/leaving-soon/Movies
#     Movies Media Path: /leaving-soon/Movies
#     (Create /leaving-soon as a library in Jellyfin pointing to this path)

# =============================================================================
# TRUENAS SCALE EXAMPLE
# =============================================================================
# Uncomment and modify for TrueNAS Scale deployments:
#
# SWEEPARR_VERSION=development-alpha
# SWEEPARR_PORT=8484
# TZ=America/Chicago
# PUID=568
# PGID=568
# CONFIG_PATH=/mnt/tank/apps/sweeparr/config
# LOG_PATH=/mnt/tank/apps/sweeparr/logs
# LEAVING_SOON_PATH=/mnt/tank/media/leaving-soon
# MEDIA_MOVIES_PATH=/mnt/tank/media/movies
# MEDIA_TV_PATH=/mnt/tank/media/tv
